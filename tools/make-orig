#!/usr/bin/env bash
# Create the orig tarball of the jank Debian package for one upstream commit.
#
# usage: tools/make-orig <commit> [output-dir]
#
# The tarball holds jank at <commit> with its submodules (immer's nested, unused submodules
# excluded) and the two components cpptrace would otherwise download at configure time
# (zstd, libdwarf-lite), at the versions cpptrace pins. Nothing from the cloned tree is
# executed. The same commit gives a byte-identical tarball (given the same tar and xz versions).
set -euo pipefail

readonly JANK_URL="https://github.com/jank-lang/jank.git"
readonly UPSTREAM_VERSION="0.1"

# What cpptrace downloads, as pinned in third-party/cpptrace/cmake/OptionVariables.cmake.
# A new jank commit that moves these pins makes this script stop until the table is updated.
readonly ZSTD_URL="https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz"
readonly ZSTD_SHA256="eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3"
readonly LIBDWARF_REPO="https://github.com/jeremy-rifkin/libdwarf-lite.git"
readonly LIBDWARF_COMMIT="5dfb2cd2aacf2bf473e5bfea79e41289f88b3a5f"

# Submodules not included (paths relative to the repository root): unused by the build.
readonly EXCLUDED_SUBMODULES=(
  "compiler+runtime/third-party/immer/extra/python/lib/pybind11"
  "compiler+runtime/third-party/immer/tools/sinusoidal-sphinx-theme"
)
# Never fetched because their parent is excluded; listed in SOURCES for completeness.
readonly EXCLUDED_WITH_PARENT=(
  "compiler+runtime/third-party/immer/extra/python/lib/pybind11/tools/clang"
)

die() { echo "make-orig: $*" >&2; exit 1; }

[[ $# -ge 1 && $# -le 2 ]] || die "usage: tools/make-orig <commit> [output-dir]"
commit_arg="$1"
out_dir="$(realpath -m "${2:-.}")"
[[ "$commit_arg" =~ ^[0-9a-f]{7,40}$ ]] || die "commit must be 7 to 40 lowercase hex digits: $commit_arg"
mkdir -p "$out_dir"

export LC_ALL=C TZ=UTC
# Ignore every user and system git configuration (url rewrites, filters, hooks); https only.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1
g() {
  git -c protocol.allow=never -c protocol.https.allow=always -c core.hooksPath=/dev/null \
      -c advice.detachedHead=false "$@"
}

work="$(mktemp -d)"
trap 'rm -rf "$work"; [[ -n "${tarball:-}" ]] && rm -f "$tarball.partial"' EXIT
src="$work/src"

echo "make-orig: cloning $JANK_URL"
g clone --quiet --no-checkout --filter=blob:none "$JANK_URL" "$src"
commit="$(g -C "$src" rev-parse --verify --quiet "${commit_arg}^{commit}")" \
  || die "commit not found or ambiguous: $commit_arg"
g -C "$src" checkout --quiet "$commit"
[[ "$(g -C "$src" rev-parse HEAD)" == "$commit" ]] || die "checkout is not at $commit"
echo "make-orig: jank $commit"

manifest="$work/SOURCES"
{
  echo "# Sources of this tarball (generated by tools/make-orig)"
  echo "# path	url	commit-or-sha256"
  echo ".	$JANK_URL	$commit"
} > "$manifest"

is_excluded() {
  local p
  for p in "${EXCLUDED_SUBMODULES[@]}"; do [[ "$1" == "$p" ]] && return 0; done
  return 1
}

# Initialise the submodules of the repository at "$1" (path "$2" relative to the root),
# checking each level's URLs before anything of that level is fetched, then recurse.
init_submodules() {
  local repo="$1" rel="$2" name path url full sub
  [[ -f "$repo/.gitmodules" ]] || return 0
  local -a entries=()
  while read -r name url; do
    name="${name#submodule.}"; name="${name%.url}"
    path="$(g -C "$repo" config -f .gitmodules --get "submodule.$name.path")" \
      || die "submodule $name in ${rel:-.}/.gitmodules has no path"
    full="${rel:+$rel/}$path"
    [[ "$url" == https://* ]] || die "non-https submodule URL refused: $full -> $url"
    entries+=("$path|$url|$full")
  done < <(g -C "$repo" config -f .gitmodules --get-regexp '^submodule\..*\.url$')
  for sub in "${entries[@]}"; do
    IFS='|' read -r path url full <<< "$sub"
    if is_excluded "$full"; then
      printf '%s\t%s\texcluded (unused by the build)\n' "$full" "$url" >> "$manifest"
      continue
    fi
    g -C "$repo" submodule --quiet update --init --filter=blob:none -- "$path"
    printf '%s\t%s\t%s\n' "$full" "$url" "$(g -C "$repo/$path" rev-parse HEAD)" >> "$manifest"
    init_submodules "$repo/$path" "$full"
  done
}
echo "make-orig: submodules"
init_submodules "$src" ""
for p in "${EXCLUDED_WITH_PARENT[@]}"; do
  printf '%s\t-\texcluded with its parent submodule\n' "$p" >> "$manifest"
done

# cpptrace's pins must still be the ones this script vendors.
opts="$src/compiler+runtime/third-party/cpptrace/cmake/OptionVariables.cmake"
[[ -f "$opts" ]] || die "missing $opts"
pin() { sed -n "s/^set($1 \"\([^\"]*\)\".*/\1/p" "$opts"; }
[[ "$(pin CPPTRACE_ZSTD_URL)" == "$ZSTD_URL" ]] || die "cpptrace zstd pin changed: $(pin CPPTRACE_ZSTD_URL)"
[[ "$(pin CPPTRACE_LIBDWARF_REPO)" == "$LIBDWARF_REPO" ]] || die "cpptrace libdwarf repo changed: $(pin CPPTRACE_LIBDWARF_REPO)"
[[ "$(pin CPPTRACE_LIBDWARF_TAG)" == "$LIBDWARF_COMMIT" ]] || die "cpptrace libdwarf commit changed: $(pin CPPTRACE_LIBDWARF_TAG)"

vendor_rel="compiler+runtime/third-party/debian-vendor"
vendor="$src/$vendor_rel"
mkdir -p "$vendor/zstd" "$vendor/libdwarf-lite"

echo "make-orig: zstd"
curl --proto '=https' --tlsv1.2 -fsSL -o "$work/zstd.tar.gz" "$ZSTD_URL"
echo "$ZSTD_SHA256  $work/zstd.tar.gz" | sha256sum --check --quiet - \
  || die "zstd SHA-256 mismatch (expected $ZSTD_SHA256)"
tar -xzf "$work/zstd.tar.gz" -C "$vendor/zstd" --strip-components=1 --no-same-owner --no-same-permissions
printf '%s\t%s\tsha256:%s\n' "$vendor_rel/zstd" "$ZSTD_URL" "$ZSTD_SHA256" >> "$manifest"

echo "make-orig: libdwarf-lite"
g init --quiet "$vendor/libdwarf-lite"
g -C "$vendor/libdwarf-lite" fetch --quiet --depth 1 "$LIBDWARF_REPO" "$LIBDWARF_COMMIT"
g -C "$vendor/libdwarf-lite" checkout --quiet FETCH_HEAD
[[ "$(g -C "$vendor/libdwarf-lite" rev-parse HEAD)" == "$LIBDWARF_COMMIT" ]] || die "libdwarf-lite is not at $LIBDWARF_COMMIT"
printf '%s\t%s\t%s\n' "$vendor_rel/libdwarf-lite" "$LIBDWARF_REPO" "$LIBDWARF_COMMIT" >> "$manifest"

cp "$manifest" "$vendor/SOURCES"

# Version and timestamps come from the commit, in UTC.
commit_time="$(g -C "$src" log -1 --format=%ct "$commit")"
commit_date="$(g -C "$src" log -1 --format=%cd --date=format-local:%Y%m%d "$commit")"
version="${UPSTREAM_VERSION}~git${commit_date}.${commit:0:7}"
top="jank-${version}"

find "$src" -name .git -prune -exec rm -rf {} +
mv "$src" "$work/$top"

tarball="$out_dir/jank_${version}.orig.tar.xz"
# Written under a temporary name and renamed when complete, so that a failure never leaves
# a truncated tarball under the real name.
tar --sort=name --format=gnu --mtime="@${commit_time}" \
    --owner=0 --group=0 --numeric-owner --mode=u+rwX,go+rX,go-w \
    -C "$work" -cf - "$top" | xz -T1 -6 -c > "$tarball.partial"
mv "$tarball.partial" "$tarball"

echo "make-orig: version $version"
echo "make-orig: $(sha256sum "$tarball")"
